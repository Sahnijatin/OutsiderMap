# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — required for webhooks, signal recompute, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---------------------------------------------------------------------
# Which chat provider to use: anthropic | openai
AI_PROVIDER=anthropic
# Optional model override; adapters have sensible defaults.
# AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=your-anthropic-key
# Also used for embeddings regardless of AI_PROVIDER.
OPENAI_API_KEY=your-openai-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
