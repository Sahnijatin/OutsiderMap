# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — required for webhooks, signal recompute, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---------------------------------------------------------------------
# Which chat provider to use: anthropic | openai
AI_PROVIDER=anthropic
# Optional model override; adapters have sensible defaults.
# AI_MODEL=claude-opus-4-8
# Optional fast model for latency-critical steps (chat decisions).
# Defaults: claude-haiku-4-5-20251001 (anthropic) / gpt-4o-mini (openai).
# AI_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-anthropic-key
# Also used for embeddings regardless of AI_PROVIDER.
OPENAI_API_KEY=your-openai-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Jobs -------------------------------------------------------------------
# Protects /api/cron/recompute (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "OutsiderMap <hello@outsidermap.com>".
RESEND_FROM=OutsiderMap <hello@outsidermap.com>
# Where new-application notifications are sent. Omit to disable admin emails.
RESEND_ADMIN_EMAIL=team@outsidermap.com

# Public site key (rendered in the widget) + server secret. Omit both to
# disable the check (e.g. local dev).

# --- Upstash Redis (rate limiting on /join) ---------------------------------
# REST URL + token from the Upstash console. Omit both to disable rate limiting.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# one-and-done). Use for your own test addresses.

# --- Moderation providers (UGC moderation, epic #70) -------------------------
# All providers sit behind swappable interfaces; selection is config + an
# adapter, not a re-architecture. Omit while unset — the defaults are
# fail-safe: text is screened live, media is HELD for human review, and the
# CSAM scanner is a no-op until a real vendor is wired. See
# docs/moderation/vendor-selection.md and launch-checklist.md.
#
# Image/video (#84): hive | rekognition | vision. Unset => hold-for-review.
# MODERATION_IMAGE_PROVIDER=rekognition
# (+ the chosen provider's own credentials, e.g. AWS_* / HIVE_API_KEY / GOOGLE_*)
#
# CSAM hash-matching (#85, mandatory): photodna | cloudflare | thorn.
# Unset => no-op (media hold-for-review is the backstop). Legally required
# before public launch.
# MODERATION_CSAM_PROVIDER=photodna
# PHOTODNA_API_KEY=

# --- Native mobile sign-in (Capacitor app, #151) -----------------------------
# In-app Apple + Google sign-in *sheets* on the native app (via
# @capgo/capacitor-social-login → Supabase signInWithIdToken). Buttons stay
# hidden until these are set, so nothing broken ships. Web sign-in ignores them.
# NEXT_PUBLIC_* means they're baked into the client bundle on the hosting deploy.
#
# Google OAuth client IDs (Google Cloud console):
# NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com   # iOS client
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com   # Web client (Android + token audience)
#
# Sign in with Apple (needs an Apple Developer account + the capability on the
# iOS app target for signed device builds):
# NEXT_PUBLIC_APPLE_SIGN_IN=1
