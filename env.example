# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — required for webhooks, signal recompute, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---------------------------------------------------------------------
# Which chat provider to use: anthropic | openai
AI_PROVIDER=anthropic
# Optional model override; adapters have sensible defaults.
# AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=your-anthropic-key
# Also used for embeddings regardless of AI_PROVIDER.
OPENAI_API_KEY=your-openai-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Jobs -------------------------------------------------------------------
# Protects /api/cron/recompute (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string

# --- Razorpay (Phase 4) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Subscription plan for premium (create in Razorpay dashboard).
RAZORPAY_PREMIUM_PLAN_ID=plan_xxx
# Exposed to the client for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# --- Resend (transactional email) -------------------------------------------
# Server-only. Powers the /join waitlist confirmation + admin notification.
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "OutsiderMap <hello@outsidermap.com>".
RESEND_FROM=OutsiderMap <hello@outsidermap.com>
# Where new-application notifications are sent. Omit to disable admin emails.
RESEND_ADMIN_EMAIL=team@outsidermap.com

# --- Cloudflare Turnstile (bot protection on /join) -------------------------
# Public site key (rendered in the widget) + server secret. Omit both to
# disable the check (e.g. local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Upstash Redis (rate limiting on /join) ---------------------------------
# REST URL + token from the Upstash console. Omit both to disable rate limiting.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
