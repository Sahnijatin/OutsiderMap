# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# capacitor native projects — generated fresh each build from capacitor.config.ts
# (hybrid app: nothing hand-edited in them), so they are not committed. See
# .github/workflows/android-build.yml / ios-build-check.yml and MOBILE_PLAN.md §6.
/ios
/android

# local scratch / generated previews
/scratch/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code personal/machine-specific config
.claude/settings.local.json
