# Copy to .env and fill in. All values are EXPO_PUBLIC_* — they are embedded in
# the client bundle, so only ever put publishable values here (never service
# keys or secrets).

# The deployed web app that serves /api/* (e.g. https://outsidermap.vercel.app).
# For local backend dev use your machine's LAN IP, not localhost, so a device
# on the same network can reach it (e.g. http://192.168.1.10:3000).
EXPO_PUBLIC_API_URL=

# Same Supabase project as the web app (Dashboard → Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Google sign-in. Buttons stay hidden until these are set.
# Web client id goes to Supabase Auth too; the reversed iOS client id must
# also be placed in app.json (google-signin plugin iosUrlScheme).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
